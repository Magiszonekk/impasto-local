#!/usr/bin/env bash
# Monthly system update from a pinned Arch Linux Archive snapshot.
# Usage: sys-update            -> moves the date to the 1st of the current month
#        sys-update YYYY/MM/DD -> moves it to the given date (e.g. an urgent fix)
set -euo pipefail

MIRRORLIST=/etc/pacman.d/mirrorlist
ARCHIVE=https://archive.archlinux.org/repos
# The impasto directory (a clean clone of the author's repo; my changes are in ~/impasto-local).
IMPASTO_DIR="${IMPASTO_DIR:-$HOME/impasto}"
# The command that rebuilds impasto's Hyprland plugins.
IMPASTO_REBUILD_CMD="${IMPASTO_REBUILD_CMD:-./setup plugins}"

c_b=$'\e[1m'; c_g=$'\e[32m'; c_y=$'\e[33m'; c_r=$'\e[31m'; c_0=$'\e[0m'
die() { echo "${c_r}ERROR:${c_0} $*" >&2; exit 1; }

cur=$(grep -oE 'archive\.archlinux\.org/repos/[0-9]{4}/[0-9]{2}/[0-9]{2}' "$MIRRORLIST" | head -1 | cut -d/ -f3-) \
  || die "$MIRRORLIST has no pinned archive date."
new="${1:-$(date +%Y/%m/01)}"
[[ "$new" =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || die "Bad date format: $new (expected YYYY/MM/DD)"

echo "${c_b}Current repo snapshot:${c_0}  $cur"
echo "${c_b}New repo snapshot:${c_0}      $new"

if [[ "$new" == "$cur" ]]; then
  echo "${c_g}The date does not change, nothing to do.${c_0}"; exit 0
fi
if [[ "$new" < "$cur" ]]; then
  echo "${c_y}WARNING: the new date is EARLIER than the current one. pacman -Su will not downgrade (-Suu does). Aborting.${c_0}"
  exit 1
fi

code=$(curl -s -o /dev/null -w '%{http_code}' "$ARCHIVE/$new/core/os/x86_64/core.db" || true)
[[ "$code" == 200 ]] || die "Snapshot $new does not exist in the archive (HTTP $code)."

hypr_new=$(curl -s "$ARCHIVE/$new/extra/os/x86_64/extra.db" | bsdtar -tf - 2>/dev/null | grep -oE '^hyprland-[0-9][^/]*' | head -1 | sed 's/^hyprland-//')
echo "${c_b}Hyprland in the new snapshot:${c_0} ${hypr_new:-?}  (installed: $(pacman -Q hyprland 2>/dev/null | cut -d' ' -f2 || echo none))"

read -rp "Continue with the update? [y/N] " ans
[[ "$ans" =~ ^[yY]$ ]] || { echo "Cancelled."; exit 0; }

ver() { pacman -Q "$1" 2>/dev/null | cut -d' ' -f2 || true; }
linux_before=$(ver linux); hypr_before=$(ver hyprland)
last_snap_before=$(snapper -c root --csvout list --columns number 2>/dev/null | tail -1 || echo 0)

echo "${c_b}==> Moving the date in mirrorlist${c_0}"
sudo sed -i -E "s#(archive\.archlinux\.org/repos/)[0-9]{4}/[0-9]{2}/[0-9]{2}#\1$new#" "$MIRRORLIST"
grep -E '^Server' "$MIRRORLIST"

echo "${c_b}==> Updating keys${c_0}"
sudo pacman -Sy --needed --noconfirm archlinux-keyring
echo "${c_b}==> Full update (snap-pac takes pre/post snapshots)${c_0}"
sudo pacman -Su

if command -v yay >/dev/null; then
  echo "${c_b}==> Updating the AUR${c_0}"
  yay -Sua || echo "${c_y}yay -Sua failed: check by hand.${c_0}"
fi

linux_after=$(ver linux); hypr_after=$(ver hyprland)

if [[ -n "$hypr_after" && "$hypr_before" != "$hypr_after" ]]; then
  echo "${c_y}==> Hyprland: $hypr_before -> $hypr_after. The impasto plugins must be rebuilt.${c_0}"
  if [[ -n "$IMPASTO_REBUILD_CMD" && -d "$IMPASTO_DIR" ]]; then
    (cd "$IMPASTO_DIR" && eval "$IMPASTO_REBUILD_CMD")
  else
    echo "   (IMPASTO_REBUILD_CMD is not set; do it by hand from a running Hyprland session)"
  fi
fi

first_snap=$(snapper -c root --csvout list --columns number,type,description 2>/dev/null \
  | awk -F, -v b="$last_snap_before" 'NR>1 && $1+0>b+0 && $2=="pre"{print $1; exit}')

echo
echo "${c_b}===== SUMMARY =====${c_0}"
echo "Repo snapshot: $cur -> ${c_g}$new${c_0}"
echo "linux:    $linux_before -> $linux_after"
echo "hyprland: ${hypr_before:-none} -> ${hypr_after:-none}"
if [[ -n "$first_snap" ]]; then
  echo "Rollback: snapper snapshot ${c_b}#$first_snap${c_0} (the state before the update, visible in the Limine menu → Snapshots)"
fi
if [[ "$linux_before" != "$linux_after" ]]; then
  echo "${c_y}The kernel changed: reboot.${c_0}"
fi
