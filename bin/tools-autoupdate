#!/usr/bin/env bash
# Automatic update of Hermes and herdr (does not touch pacman or the AUR; sys-update does that).
# Run daily by tools-autoupdate.timer, but it only really checks every
# INTERVAL_DAYS days (default 3), so a computer that was off breaks nothing.
#
# Usage:
#   tools-autoupdate            normally (respecting the interval)
#   tools-autoupdate --force    ignores the interval
#   tools-autoupdate --dry      only shows what it would update
#   tools-autoupdate hermes|herdr   just one tool
#
# herdr: `herdr update` without --handoff replaces the binary and does NOT close
#   running servers or agent panes. The new server takes over on their next restart.
# Hermes: `hermes update --yes` backs up the state and restarts the gateway (drain-first).
set -u

INTERVAL_DAYS=${INTERVAL_DAYS:-3}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/tools-autoupdate
LOG=$STATE/log
STAMP=$STATE/last-check
export PATH="$HOME/.local/bin:$PATH"
mkdir -p "$STATE"

FORCE=0; DRY=0; WHICH=all
for a in "$@"; do
    case $a in
        --force) FORCE=1 ;;
        --dry)   DRY=1; FORCE=1 ;;
        hermes|herdr) WHICH=$a ;;
        *) echo "unknown argument: $a" >&2; exit 2 ;;
    esac
done

log() { printf '%s %s\n' "$(date -Is)" "$*" | tee -a "$LOG"; }
notify() { notify-send -u normal -i system-software-update "$1" "$2" 2>/dev/null || true; }
trim_log() { [[ -f $LOG ]] && tail -n 300 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"; }

# one instance at a time
exec 9>"$STATE/lock"
flock -n 9 || { echo "another instance is already running"; exit 0; }

if (( ! FORCE )) && [[ -f $STAMP ]]; then
    age=$(( ( $(date +%s) - $(stat -c %Y "$STAMP") ) / 86400 ))
    (( age < INTERVAL_DAYS )) && exit 0
fi

# without a network we do nothing and leave the stamp alone (it will try on the next run)
if ! curl -fsS -m 10 -o /dev/null https://herdr.dev/latest.json; then
    log "no network, skipping"
    exit 0
fi

fail=0; changed=""

update_herdr() {
    command -v herdr >/dev/null || { log "herdr: not installed, skipping"; return; }
    local cur new
    cur=$(herdr --version 2>/dev/null | awk '{print $2}')
    new=$(curl -fsS -m 15 https://herdr.dev/latest.json | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    if [[ -z $new ]]; then log "herdr: cannot read the latest version"; fail=1; return; fi
    if [[ $cur == "$new" ]]; then log "herdr: up to date ($cur)"; return; fi
    if (( DRY )); then log "herdr: [dry] $cur -> $new"; return; fi
    log "herdr: $cur -> $new"
    if herdr update >>"$LOG" 2>&1; then
        changed+="herdr $cur→$(herdr --version 2>/dev/null | awk '{print $2}') "
    else
        log "herdr: update ERROR (details above)"; fail=1
    fi
}

update_hermes() {
    command -v hermes >/dev/null || { log "hermes: not installed, skipping"; return; }
    local before after out
    before=$(hermes --version 2>/dev/null | head -1)
    out=$(hermes update --check 2>&1)
    if grep -q "Up to date" <<<"$out"; then log "hermes: up to date ($before)"; return; fi
    if (( DRY )); then log "hermes: [dry] an update is available: $(tail -1 <<<"$out")"; return; fi
    log "hermes: updating ($before)"
    if hermes update --yes >>"$LOG" 2>&1; then
        after=$(hermes --version 2>/dev/null | head -1)
        changed+="hermes → ${after} "
    else
        log "hermes: update ERROR (details above)"; fail=1
    fi
}

[[ $WHICH == all || $WHICH == herdr  ]] && update_herdr
[[ $WHICH == all || $WHICH == hermes ]] && update_hermes

(( DRY )) || { (( fail )) || touch "$STAMP"; }
[[ -n $changed ]] && notify "Tools updated" "$changed"
(( fail )) && notify "Autoupdate error" "Check: $LOG"
trim_log
exit $fail
