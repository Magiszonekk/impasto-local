#!/usr/bin/env bash
# Reminder about the monthly sys-update. Updates nothing.
# Notifies when the pinned month in mirrorlist is older than the current one.
# Run daily by sys-update-reminder.timer (Persistent=true, so if the computer
# was off on the 1st of the month, it reminds after boot).
set -u
pin=$(grep -oE 'archive\.archlinux\.org/repos/[0-9]{4}/[0-9]{2}' "${MIRRORLIST:-/etc/pacman.d/mirrorlist}" | head -1 | cut -d/ -f3-) || exit 0
[[ -n $pin ]] || exit 0                     # not pinned (rolling): nothing to do
now=$(date +%Y/%m)
[[ $pin < $now ]] || exit 0                 # already updated this month

msg="The repositories are pinned to ${pin}. Run: sys-update"
state=${XDG_STATE_HOME:-$HOME/.local/state}/sys-update-reminder
mkdir -p "$state"
echo "$(date -Is) $msg" > "$state/last"

notify-send -u normal -i system-software-update "Time for a system update" "$msg" 2>/dev/null || true
