#!/usr/bin/env bash
# Chainload entries in Limine for systems whose bootloader sits on a DIFFERENT
# ESP partition than /boot (in my case: Windows and Ubuntu on p1, Arch on p6).
# FIND_BOOTLOADERS in limine-entry-tool only searches ESP_PATH, so it does not
# see them. The source is the UEFI entries in NVRAM (efibootmgr -v): the name,
# the partition's PARTUUID and the path to the .efi file. An entry whose name
# already exists is skipped, so running it again is safe.
#
# Usage: sudo limine-dualboot          adds the entries and runs limine-update
#        limine-dualboot --dry         only shows what it would add
set -euo pipefail

CONF=${LIMINE_CONF:-/boot/limine.conf}
ESP=${ESP_PATH:-/boot}
PRIORITY=30   # Arch has 50, "EFI fallback" 10: higher = higher in the menu
DRY=0; [[ ${1:-} == --dry ]] && DRY=1

die() { echo "limine-dualboot: $*" >&2; exit 1; }
(( DRY )) || [[ $EUID -eq 0 ]] || die "run via sudo (or with --dry)"
command -v efibootmgr >/dev/null || die "efibootmgr is missing"
(( DRY )) || [[ -f $CONF ]] || die "$CONF is missing, run limine-update first"

esp_guid=$(lsblk -no PARTUUID "$(findmnt -no SOURCE "$ESP")")
esp_guid=${esp_guid,,}
[[ -n $esp_guid ]] || die "unknown PARTUUID for $ESP"

# "Boot0000* Windows Boot Manager<TAB>HD(1,GPT,<guid>,...)/\EFI\...\X.EFI<data>"
# After the Windows path, efibootmgr appends binary data with no separator, so
# the path is cut at the first ".efi".
entries=$(efibootmgr -v | sed -nE \
    's/^Boot[0-9A-Fa-f]{4}\*? (.*[^[:space:]])[[:space:]]+HD\([0-9]+,GPT,([0-9A-Fa-f-]+),[^)]*\)\/(\\[^.]*\.[Ee][Ff][Ii]).*/\1\t\2\t\3/p')

# The real spelling of the path on the partition (NVRAM usually has it in
# CAPITALS); this also checks that the file exists. The partition is mounted
# read-only, unless it is already mounted somewhere.
MNTS=()
cleanup() { local m; for m in "${MNTS[@]}"; do umount "$m" && rmdir "$m"; done; }
trap cleanup EXIT
REAL=""
real_path() { # guid path -> $REAL
    local dev mnt found
    dev=$(readlink -f "/dev/disk/by-partuuid/$1")
    mnt=$(findmnt -rno TARGET --source "$dev" 2>/dev/null | head -1 || true)
    if [[ -z $mnt ]]; then
        mnt=$(mktemp -d /run/limine-dualboot.XXXXXX)
        mount -o ro "$dev" "$mnt" || { rmdir "$mnt"; return 1; }
        MNTS+=("$mnt")
    fi
    found=$(find "$mnt" -ipath "$mnt$2" -type f -print -quit)
    [[ -n $found ]] || return 1
    REAL=${found#"$mnt"}
}

block=""; seen=""
while IFS=$'\t' read -r name guid path; do
    [[ -n $name ]] || continue
    guid=${guid,,}
    [[ $guid != "$esp_guid" ]] || continue              # our ESP: Limine and its fallback
    [[ ${name,,} != *limine* ]] || continue
    [[ $seen != *"|$guid$path|"* ]] || continue         # the same loader twice in NVRAM
    seen+="|$guid$path|"
    if ! blkid -t PARTUUID="$guid" >/dev/null 2>&1 && [[ ! -e /dev/disk/by-partuuid/$guid ]]; then
        echo "skipping \"$name\": partition $guid does not exist (stale NVRAM entry)"; continue
    fi
    path=${path//\\//}
    if [[ -r $CONF ]] && grep -qxF "/$name" "$CONF"; then
        echo "already present: $name"; continue
    fi
    if (( ! DRY )); then
        real_path "$guid" "$path" || { echo "skipping \"$name\": no $path on $guid"; continue; }
        path=$REAL
    fi
    echo "adding: $name -> guid($guid):$path"
    block+=$'\n'"/$name"$'\n'"comment: chainload from another ESP partition (bin/limine-dualboot)"$'\n'"comment: order-priority=$PRIORITY"$'\n'"protocol: efi"$'\n'"path: guid($guid):$path"$'\n'
done <<< "$entries"

[[ -n $block ]] || { echo "nothing to add"; exit 0; }
(( DRY )) && exit 0

[[ -e $CONF.pre-dualboot ]] || cp "$CONF" "$CONF.pre-dualboot"
printf '%s' "$block" >> "$CONF"

# limine-update re-signs the config (if enroll is enabled) and tidies up the
# entries; we check that ours survived.
limine-update >/dev/null
while IFS=$'\t' read -r name _; do
    [[ $block == *$'\n'"/$name"$'\n'* ]] || continue
    grep -qxF "/$name" "$CONF" || die "limine-update removed the entry \"$name\"; backup: $CONF.pre-dualboot"
done <<< "$entries"
echo "OK. Menu: limine-entry-tool --tree 1"
