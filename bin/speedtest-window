#!/usr/bin/env python3
"""Speed test window with gauges (as in omarchy).

By default it measures through speedtest-cli (the server is picked
automatically, the needle rises live from the counters of its threads). The
result is the average over the window of full parallelism (after the ramp-up,
until the last request starts), not the sum of bytes over the whole time as in
speedtest-cli itself, which understates the result with its ramp-up and with
the threads winding down at the end. When speedtest-cli is missing or fails,
it falls back to speed.cloudflare.com with a live needle. The final screen
shows the Download and Upload arcs side by side, plus the ping.

  speedtest-window              speedtest-cli, Cloudflare on failure
  speedtest-window --cloudflare Cloudflare only
"""
import http.client
import math
import os
import re
import ssl
import statistics
import sys
import threading
import time

HOST = "speed.cloudflare.com"
STREAMS = 4
PHASE_SECONDS = 8.0
WARMUP = 1.5
GAUGE_MAX = 1000.0  # Mb/s at the end of the scale (square-root scale)

R, G, B, C, D, BOLD, X = ("\033[31m", "\033[32m", "\033[34m", "\033[36m",
                          "\033[2m", "\033[1m", "\033[0m")

CTX = ssl.create_default_context()
SOURCE = HOST  # server description shown in the header, updated along the way


class Refused(Exception):
    pass


class Meter:
    def __init__(self):
        self.bytes = 0
        self.lock = threading.Lock()
        self.stop = False
        self.error = None  # (HTTP code, Retry-After) when the server refuses

    def add(self, n):
        with self.lock:
            self.bytes += n


def worker_down(m):
    while not m.stop:
        try:
            c = http.client.HTTPSConnection(HOST, context=CTX, timeout=10)
            c.request("GET", "/__down?bytes=50000000")
            r = c.getresponse()
            if r.status != 200:
                m.error = (r.status, r.getheader("Retry-After"))
                m.stop = True
                return
            while not m.stop:
                chunk = r.read(65536)
                if not chunk:
                    break
                m.add(len(chunk))
            c.close()
        except Exception:
            time.sleep(0.2)


def worker_up(m):
    block = b"\0" * 65536
    size = 20_000_000
    while not m.stop:
        try:
            c = http.client.HTTPSConnection(HOST, context=CTX, timeout=10)
            c.putrequest("POST", "/__up")
            c.putheader("Content-Length", str(size))
            c.endheaders()
            sent = 0
            while sent < size and not m.stop:
                c.send(block)
                sent += len(block)
                m.add(len(block))
            if not m.stop:
                r = c.getresponse()
                r.read()
                if r.status != 200:
                    m.error = (r.status, r.getheader("Retry-After"))
                    m.stop = True
                    return
            c.close()
        except Exception:
            time.sleep(0.2)


def ping():
    times = []
    c = http.client.HTTPSConnection(HOST, context=CTX, timeout=5)
    for _ in range(8):
        t = time.perf_counter()
        c.request("GET", "/__down?bytes=0")
        c.getresponse().read()
        times.append((time.perf_counter() - t) * 1000)
    c.close()
    times = times[1:]  # the first one includes the TLS handshake
    return statistics.median(times), (max(times) - min(times))


# ── drawing ─────────────────────────────────────────────────────────────────

W, H = 25, 11  # radius in columns (cell ~2:1) and the arc height


def frac(v):
    return min(1.0, math.sqrt(max(v, 0) / GAUGE_MAX))


def gauge(value, color):
    """A semicircular arc with a scale and a needle. Returns a list of lines."""
    cols = W * 2 + 1
    grid = [[" "] * cols for _ in range(H + 1)]
    cx, cy = W, H
    f = frac(value)

    def put(x, y, ch, col):
        xi, yi = int(round(x)), int(round(y))
        if 0 <= xi < cols and 0 <= yi <= H:
            grid[yi][xi] = col + ch + X

    n = 140
    for i in range(n + 1):
        t = i / n
        a = math.pi * (1 - t)
        x = cx + math.cos(a) * W
        y = cy - math.sin(a) * (H - 0.5)
        put(x, y, "●" if t <= f else "·", color if t <= f else D)

    for mark in (0, 10, 50, 100, 250, 500, 1000):
        t = math.sqrt(mark / GAUGE_MAX)
        a = math.pi * (1 - t)
        x = cx + math.cos(a) * (W - 3.5)
        y = cy - math.sin(a) * (H - 0.5 - 2)
        label = str(mark)
        x0 = int(round(x - len(label) / 2))
        for k, ch in enumerate(label):
            put(x0 + k, y, ch, D)

    a = math.pi * (1 - f)
    steps = 40
    for i in range(3, steps):
        r = i / steps
        put(cx + math.cos(a) * (W - 6) * r, cy - math.sin(a) * (H - 3) * r,
            "•", BOLD + color)
    put(cx, cy, "◉", BOLD)

    return ["".join(row) for row in grid]


BLOCK_W = 2 * W + 1   # arc width in columns
BELOW = 5             # rows under the number: up to 3 results, bar/gap, hint
BLOCK_H = 3 + (H + 1) + 2 + BELOW  # fixed height so nothing jumps

ANSI = re.compile(r"\033\[[0-9;]*m")


def centred(text, pad, width=None):
    """Centres a row relative to the arc or to a given width (ignoring ANSI codes)."""
    n = len(ANSI.sub("", text))
    return pad + " " * max(0, ((width or BLOCK_W) - n) // 2) + text


def draw(title, value, color, lines_below):
    cols, lines = os.get_terminal_size() if sys.stdout.isatty() else (80, 24)
    pad = " " * max(0, (cols - BLOCK_W) // 2)
    top = max(0, (lines - BLOCK_H) // 2)
    rows = [""] * top
    rows += [centred(f"{BOLD}󰓅  Speed test{X}   {D}{SOURCE}{X}", pad),
             "", centred(title, pad)]
    rows += [pad + line for line in gauge(value, color)]
    rows.append(f"{pad}{' ' * (W - 6)}{BOLD}{color}{value:7.1f}{X} Mb/s")
    rows.append("")
    below = [centred(line.strip(), pad) if line.strip() else "" for line in lines_below]
    rows += below + [""] * (BELOW - len(below))
    out = "\033[H" + "".join(r + "\033[K\n" for r in rows) + "\033[J"
    sys.stdout.write(out)
    sys.stdout.flush()


GAP = 6  # gap between the arcs on the final screen


def draw_final(down, up, lines_below, source=None):
    """Final screen: the Download and Upload arcs side by side, results below."""
    cols, lines = os.get_terminal_size() if sys.stdout.isatty() else (80, 24)
    total = BLOCK_W * 2 + GAP
    pad = " " * max(0, (cols - total) // 2)
    top = max(0, (lines - BLOCK_H) // 2)
    rows = [""] * top
    head = f"{BOLD}󰓅  Speed test{X}   {D}{source or SOURCE}{X}"
    n = len(ANSI.sub("", head))
    rows += [pad + " " * max(0, (total - n) // 2) + head, ""]
    mid = BLOCK_W // 2
    title = [" "] * total
    for start, word in ((mid - 4, "Download"), (BLOCK_W + GAP + mid - 3, "Upload")):
        for k, ch in enumerate(word):
            title[start + k] = ch
    plain = "".join(title)
    plain = plain.replace("Download", f"{BOLD}{G}Download{X}").replace("Upload", f"{BOLD}{B}Upload{X}")
    rows.append(pad + plain)
    for l1, l2 in zip(gauge(down, G), gauge(up, B)):
        rows.append(pad + l1 + " " * GAP + l2)
    v1 = f"{BOLD}{G}{down:7.1f}{X} Mb/s"
    v2 = f"{BOLD}{B}{up:7.1f}{X} Mb/s"
    left = " " * (W - 6)
    rows.append(pad + left + v1 + " " * (BLOCK_W - (W - 6) - len(ANSI.sub("", v1)) + GAP) + left + v2)
    rows.append("")
    below = [centred(line.strip(), pad, total) if line.strip() else "" for line in lines_below]
    rows += below
    sys.stdout.write("\033[H" + "".join(r + "\033[K\n" for r in rows) + "\033[J")
    sys.stdout.flush()


def run_phase(name, color, worker, results):
    m = Meter()
    for _ in range(STREAMS):
        threading.Thread(target=worker, args=(m,), daemon=True).start()
    t0 = time.perf_counter()
    window = []
    shown = 0.0
    warm = None
    while True:
        now = time.perf_counter() - t0
        if now >= PHASE_SECONDS:
            break
        with m.lock:
            b = m.bytes
        if m.error:
            raise Refused(m.error)
        window.append((now, b))
        window = [w for w in window if now - w[0] <= 1.0]
        if now >= WARMUP and warm is None:
            warm = (now, b)
        if len(window) >= 2 and now - window[0][0] > 0.15:
            inst = (b - window[0][1]) * 8 / 1e6 / (now - window[0][0])
        else:
            inst = 0.0
        shown += (inst - shown) * 0.35  # needle smoothing
        bar = int(now / PHASE_SECONDS * 40)
        prog = f"{color}{'━' * bar}{X}{D}{'━' * (40 - bar)}{X}"
        draw(f"{BOLD}{name}{X}", shown, color, results + ["  " + prog])
        time.sleep(0.05)
    m.stop = True
    with m.lock:
        b = m.bytes
    end = time.perf_counter() - t0
    if warm and end > warm[0]:
        return (b - warm[1]) * 8 / 1e6 / (end - warm[0])
    return b * 8 / 1e6 / end


def load_speedtest():
    """Imports the speedtest-cli module (a system package, may be outside sys.path)."""
    try:
        import speedtest
        return speedtest
    except ImportError:
        import glob
        for d in sorted(glob.glob("/usr/lib/python3*/site-packages")):
            if d not in sys.path:
                sys.path.append(d)
        try:
            import speedtest
            return speedtest
        except ImportError:
            return None


def plateau(samples, last_start, end_el):
    """Average speed (Mb/s) over the window of full parallelism: from the end of
    the ramp-up (WARMUP) to the start of the last request in speedtest-cli's
    queue, since after that only winding-down threads remain. samples: a list
    of (time since the phase started, bytes). Returns None if the window is
    too short."""
    t1 = min(last_start, end_el) if last_start is not None else end_el
    t0 = WARMUP
    if t1 - t0 < 1.0 or len(samples) < 2:
        return None

    def at(t):
        prev = samples[0]
        for cur in samples:
            if cur[0] >= t:
                if cur[0] == prev[0]:
                    return cur[1]
                k = (t - prev[0]) / (cur[0] - prev[0])
                return prev[1] + (cur[1] - prev[1]) * k
            prev = cur
        return samples[-1][1]

    return (at(t1) - at(t0)) * 8 / 1e6 / (t1 - t0)


def run_cli():
    """Test through the speedtest-cli module with a live needle: the byte
    counters come from its download and upload threads. Returns a dict or None."""
    global SOURCE
    lib = load_speedtest()
    if lib is None:
        return None
    SOURCE = "speedtest-cli · choosing a server..."
    tracked = {"down": [], "up": []}

    class Down(lib.HTTPDownloader):
        def __init__(self, *a, **k):
            super().__init__(*a, **k)
            tracked["down"].append(self)

    class Up(lib.HTTPUploader):
        def __init__(self, *a, **k):
            super().__init__(*a, **k)
            tracked["up"].append(self)

    lib.HTTPDownloader, lib.HTTPUploader = Down, Up
    st = {"phase": "ping", "err": None, "done": False, "obj": None, "down": 0.0,
          "finished": 0, "total": 1, "last_start": None}

    def on_request(i, n, start=False, end=False):
        """speedtest-cli callback: the phase ends after the last request or after 10 s."""
        st["total"] = n
        if start and i == n - 1:
            st["last_start"] = time.perf_counter() - st["start"]
        if end:
            st["finished"] += 1

    def job():
        try:
            t = lib.Speedtest()
            st["obj"] = t
            t.get_best_server()
            st["phase"], st["finished"], st["last_start"] = "down", 0, None
            st["start"] = time.perf_counter()
            st["down"] = t.download(callback=on_request) / 1e6
            st["phase"], st["finished"], st["last_start"] = "up", 0, None
            st["start"] = time.perf_counter()
            t.upload(callback=on_request)
        except Exception as e:  # noqa: BLE001
            st["err"] = e
        st["done"] = True

    threading.Thread(target=job, daemon=True).start()

    def total(phase):
        if phase == "down":
            return sum(sum(t.result) for t in list(tracked["down"]))
        return sum(sum(t.request.data.total) for t in list(tracked["up"]))

    spin = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    t0 = time.perf_counter()
    window, shown, last, results = [], 0.0, "ping", []
    samples, final = [], {}

    def finish(phase, lib_value):
        """The phase result: from the full-parallelism window, else from the library."""
        end_el = samples[-1][0] if samples else 0.0
        v = plateau(samples, st["last_start"], end_el)
        final[phase] = v if v is not None else lib_value
    while not st["done"]:
        now = time.perf_counter() - t0
        phase = st["phase"]
        obj = st["obj"]
        if obj is not None and obj.results.server and SOURCE.endswith("..."):
            srv = obj.results.server
            SOURCE = f"speedtest-cli · {srv.get('sponsor', '?')} ({srv.get('name', '?')})"
            results.append(f"  Ping       {BOLD}{obj.results.ping:.0f} ms{X}")
        if phase != last:
            window, shown = [], 0.0
            if last == "down":
                finish("down", st["down"])
                results.append(f"  Download   {BOLD}{G}{final['down']:.1f} Mb/s{X}")
            samples = []
            last = phase
        if phase == "ping":
            draw(f"{BOLD}Ping{X}", 0, C,
                 [f"  {spin[int(now * 10) % len(spin)]}  looking for the best server"])
        else:
            color, name = (G, "Download") if phase == "down" else (B, "Upload")
            el = time.perf_counter() - st["start"]
            b = total(phase)
            samples.append((el, b))
            window.append((el, b))
            window = [w for w in window if el - w[0] <= 1.0]
            inst = 0.0
            if len(window) >= 2 and el - window[0][0] > 0.15:
                inst = (b - window[0][1]) * 8 / 1e6 / (el - window[0][0])
            shown += (inst - shown) * 0.35
            frac_done = max(el / 10.0, st["finished"] / max(1, st["total"]))
            bar = min(40, int(frac_done * 40))
            prog = f"{color}{'━' * bar}{X}{D}{'━' * (40 - bar)}{X}"
            draw(f"{BOLD}{name}{X}", shown, color, results + ["  " + prog])
        time.sleep(0.05)
    obj = st["obj"]
    if st["err"] is not None or obj is None or not obj.results.upload:
        return None
    r = obj.results
    finish("up", r.upload / 1e6)
    return {"down": final.get("down", st["down"]), "up": final["up"], "ping": r.ping,
            "jitter": None, "source": SOURCE}


def run_cloudflare():
    """Test through Cloudflare. Raises Refused (429) or OSError (no network)."""
    global SOURCE
    SOURCE = HOST
    results = []
    draw(f"{BOLD}Ping{X}", 0, C, ["  Connecting..."])
    p, jitter = ping()
    results.append(f"  Ping       {BOLD}{p:.0f} ms{X}  {D}(jitter {jitter:.0f} ms){X}")
    down = run_phase("Download", G, worker_down, results)
    results.append(f"  Download   {BOLD}{G}{down:.1f} Mb/s{X}")
    up = run_phase("Upload", B, worker_up, results)
    return {"down": down, "up": up, "ping": p, "jitter": jitter, "source": HOST}


def main():
    only_cf = "--cloudflare" in sys.argv[1:]
    sys.stdout.write("\033[?1049h\033[?25l\033[2J")
    try:
        res = None if only_cf else run_cli()
        fell_back = res is None and not only_cf
        if res is None:
            try:
                res = run_cloudflare()
            except Refused as e:
                code, retry = e.args[0]
                sys.stdout.write("\033[2J\033[H")
                print(f"\n  {R}The server refused the measurement (HTTP {code}){X}")
                if code == 429:
                    when = f" Try again in about {int(retry) // 60} min." if (retry or "").isdigit() else ""
                    print(f"  {D}Cloudflare's request limit for your IP.{when}{X}")
                input("\n  Press Enter to close... ")
                return
            except Exception as e:
                sys.stdout.write("\033[2J\033[H")
                print(f"\n  {R}No connection (speedtest-cli and {HOST}){X}\n  {D}{e}{X}")
                input("\n  Press Enter to close... ")
                return
        jit = f"  {D}(jitter {res['jitter']:.0f} ms){X}" if res["jitter"] is not None else ""
        info = [f"  Ping       {BOLD}{res['ping']:.0f} ms{X}{jit}"]
        if fell_back:
            info.append(f"  {D}speedtest-cli failed, result from Cloudflare{X}")
        draw_final(res["down"], res["up"], info + ["", f"{D}Press any key to close{X}"],
                   res["source"])
        os.system("stty -echo -icanon min 1 2>/dev/null")
        sys.stdin.read(1)
    finally:
        sys.stdout.write("\033[?25h\033[?1049l")
        os.system("stty sane 2>/dev/null")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.stdout.write("\033[?25h\033[?1049l")
