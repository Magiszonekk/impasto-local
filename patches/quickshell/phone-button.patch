diff --git a/home/.config/quickshell/services/PhoneService.qml b/home/.config/quickshell/services/PhoneService.qml
new file mode 100644
index 0000000..7e6791f
--- /dev/null
+++ b/home/.config/quickshell/services/PhoneService.qml
@@ -0,0 +1,29 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// Lokalny dodatek: czy telefon jest widoczny w adb (Wireless debugging).
+// Odpytuje `adb devices` co kilka sekund; `connected` gaśnie, gdy telefon
+// zniknie z sieci albo parowanie zostanie zerwane.
+Singleton {
+    id: root
+
+    property bool connected: false
+
+    readonly property Process probe: Process {
+        command: ["sh", "-c", "ADB_MDNS_OPENSCREEN=0 timeout 5 adb devices 2>/dev/null | awk 'NR>1 && $2==\"device\"' | wc -l"]
+        running: true
+        stdout: StdioCollector {
+            onStreamFinished: root.connected = parseInt(text.trim()) > 0
+        }
+    }
+
+    readonly property Timer poll: Timer {
+        interval: 5000
+        running: true
+        repeat: true
+        onTriggered: if (!root.probe.running) root.probe.running = true
+    }
+}
