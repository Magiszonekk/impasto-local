# Local (magiszonek), sourced from the end of the author's ~/.zshrc.
# · greeting on every new kitty window (animation + system info). Only in
#   kitty: icat does not work in tmux/herdr or over ssh. Turn off: touch ~/.config/no-greeting
if [[ -o interactive && -n $KITTY_WINDOW_ID && -z $TMUX && -z $HERDR_ENV && -z $SSH_TTY \
      && ! -e ~/.config/no-greeting ]]; then
    fa
fi
